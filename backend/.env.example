# Template: copia in backend/.env e inserisci i valori reali SOLO in .env (questo file va nel repository).

OPENAI_API_KEY=sk-...

# GPT Image 2 produce sia le board di analisi sia le prove sulla foto
IMAGE_MODEL=gpt-image-2
IMAGE_OUTPUT_FORMAT=webp

# Board di analisi (contengono testo: serve qualità alta per la leggibilità)
BOARD_QUALITY=high
BOARD_SIZE=1536x1024

# Prove sulla foto
PREVIEW_QUALITY=medium
FINAL_QUALITY=high

# PostgreSQL. In locale usa l'URL PUBBLICO di Railway (DATABASE_PUBLIC_URL, host *.proxy.rlwy.net):
# postgres.railway.internal è raggiungibile solo dai servizi deployati su Railway.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# Clerk (Dashboard → API keys)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Facoltativi: JWKS (default derivato dalla publishable key) e origini ammesse nel claim azp (default CORS_ORIGINS)
# CLERK_JWKS_URL=https://<frontend-api>/.well-known/jwks.json
# CLERK_AUTHORIZED_PARTIES=["http://localhost:5173"]

CORS_ORIGINS=["http://localhost:5173"]
